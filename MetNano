#!/bin/bash

#---------
# MetNano
#---------

# Usage
USAGE="
--------
MetNano
--------

DESCRIPTION:
MetNano runs a metagenomic analysis pipeline using provided FASTQ files from Nanopore sequencing.
It is the first step to process the raw basecall data compiled in one file fastQ folder

USAGE:
./MetNano -L [association_file] -o [output_dir] -n [dir_with_nanopore_fastqs] -f [force] -Q [quality_analysis]

MANDATORY ARGUMENTS:
-L [association_file]  		: Path to the association file containing the barcode IDs and associated sample names
-o [output_dir]			: Path to the output directory where results will be stored
-n [input_folder_nanopore] 	: Directory containing Nanopore FASTQ files

OPTIONAL ARGUMENTS:
-f [T or F]    		: Use previous folder regardless of the date (default = F)
-Q [T or F]    		: Perform the quality check on FASTQs (default = T)
-q [minQ]      		: Nanopore quality score filtering parameter used for chopper (default  = 15)
-l [minlength] 		: Nanopore sequence length filtering parameter used for chopper (default  = 300)
-c [confidence kraken2] : Confidence score used for Kraken2 (default = 0.1)
-d [database kraken2] 	: Database used for Kraken2 (default = /mnt/ibis/rclevesq/DATABASES/kraken2_dbs/k2_core_nt_20251015/)
-m [matched_reads]	: FASTQ file of reads matching selected genomes (default = none)

ADDITIONAL OPTIONS:
-h                	: Display this help message and exit

EXAMPLE:
./MetNano -L metadata.txt -o output_dir -n /path/to/nanopore/ -f [T] || [F] -Q [T] || [F]

AUTHORS:
Guillaume Nguyen, Jeff Gauthier and Anthony Piot (Levesque Lab)
2026-01-07
"

# Default values for optional parameters
nano_dir=""

# Function to display usage information
usage() {
    echo -e "$USAGE"
    exit 1
}

# Parse arguments using getopts
while getopts "L:o:n:f:q:l:d:c:m:h:" opt; do
    case $opt in
        L) list="$OPTARG" ;;
        o) output_dir="$OPTARG" ;;
        n) nano_dir="$OPTARG" ;;
        f) FORCE="$OPTARG" ;;
        q) qualityscore="$OPTARG" ;;
        l) minlength="$OPTARG" ;;
        d) database="$OPTARG" ;;
        c) confidence="$OPTARG" ;;
        m) readmap="$OPTARG" ;;
        h) usage ;;
        *) usage ;;
    esac
done

# Ensure mandatory parameters are provided
if [ -z "$list" ] || [ -z "$output_dir" ] ; then
        echo ""
		echo "Error: Missing required arguments. check list (-L) and output_dir (-o)"
        usage
        exit 1
fi

if [ -z "$FORCE" ]; then
        FORCE_SET="F"
        #echo "F default value, new folder will be used for assembly"
        else
        FORCE_SET="$FORCE"
        #echo "Force mod set according to the users settings" $FORCE_SET
fi

if [ -z "$readmap" ]; then
        readmap="None"
        #echo "readmap default value, no reads mappings performed"
        else
        readmap="$FORCE"
        #echo "readmap set according to the users settings with fastQ file" $readmap
fi

# Optional
if [ -z "$qualityscore" ]; then
        qualityscore=15
fi

if [ -z "$minlength" ]; then
        minlength=300
fi

if [ -z "$database" ]; then
        database='/mnt/ibis/rclevesq/DATABASES/kraken2_dbs/k2_core_nt_20251015/'
fi

if [ -z "$confidence" ]; then
        confidence=0.1
fi

# Check if user specified a dir with FASTQs
if [ -z "$list" ]; then
    echo -e "$USAGE"
    exit 1
else
    mkdir -p "$output_dir"
fi

# Move to working directory
cd $output_dir

# Lauch MetNano pipeline
python3 /project/rclevesq/software/metnano/anthony/MetNano/scripts/run_container_MetNano.py \
    -n "$nano_dir" \
    -f "$FORCE_SET" \
    -L "$list" \
    -l $minlength \
    -q $qualityscore \
    -c $confidence \
    -d $database \
    -m $readmap
