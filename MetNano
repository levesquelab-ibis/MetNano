#!/bin/bash

# Usage
USAGE='
-----------------------------------------
 __  __      _   _   _
|  \/  | ___| |_| \ | | __ _ _ __   ___
| |\/| |/ _ \ __|  \| |/ _` |  _ \ / _ \
| |  | |  __/ |_| |\  | (_| | | | | (_) |
|_|  |_|\___|\__|_| \_|\__,_|_| |_|\___/

-----------------------------------------

DESCRIPTION:
MetNano runs a metagenomic analysis pipeline using provided FASTQ files from Nanopore sequencing.
It is the first step to process the raw basecall data compiled in one file fastQ folder

USAGE:
./MetNano -f [FASTQ_directory] -o [output_directory] -d [kraken2_database]

REQUIRED ARGUMENTS:
-f [FASTQ_directory] 	: Directory containing Nanopore FASTQ files
-o [output_directory]	: Path to the output directory where results will be stored
-d [kraken2_database]   : Database used by Kraken2

OPTIONAL ARGUMENTS:
-u                      : Unzip raw FASTQs from MinKNOW folder output
-r                      : Rename FASTQs using association file (-a)
-a [association_file]  	: Path to the association file containing the barcode IDs and associated sample names (required if -r is provided)
-q [minQ]      		: Nanopore quality score filtering parameter used for chopper (default  = 15)
-l [minlength] 		: Nanopore sequence length filtering parameter used for chopper (default  = 300)
-m [reference genome]	: FASTA file of host reference genome (default = none)
-c [confidence kraken2] : Confidence score used for Kraken2 (default = 0.1)
-n [path_to_copy_db]    : Copy kraken2 database into temporay in-memory filesystem for use with --memore-mapping option in Kraken2. Typically use /dev/shm/ if available
-t [INT]                : Number of threads (default = 2)

ADDITIONAL OPTIONS:
-h                	: Display this help message and exit

EXAMPLE:
./MetNano -L metadata.txt -o output_dir -n /path/to/nanopore/ -d /path/to/kraken2/database/

AUTHORS:
Guillaume Nguyen, Jeff Gauthier and Anthony Piot (Levesque Lab)
'

# Function to display usage information
usage() {
  echo -e "$USAGE"
  exit 1
}

# Parse arguments using getopts
while getopts "o:f:q:l:d:c:m:a:t:n:ruh" opt; do
  case $opt in
    a) list="$OPTARG" ;;
    o) output_dir="$OPTARG" ;;
    f) FASTQ_dir="$OPTARG" ;;
    q) qualityscore="$OPTARG" ;;
    l) minlength="$OPTARG" ;;
    d) database="$OPTARG" ;;
    c) confidence="$OPTARG" ;;
    m) mapping="$OPTARG" ;;
    n) memory_mapping="$OPTARG" ;;
    r) rename="True" ;;
    u) unzip="True" ;;
    t) threads="$OPTARG" ;;
    h) usage ;;
    *) usage ;;
  esac
done

# Ensure mandatory parameters are provided
if [[ -z "$FASTQ_dir" || -z "$output_dir" || -z "$database" ]]
  then
    echo "Error: Missing required arguments. Check FASTQ directory (-f), output_dir (-o), and kraken2 database (-d)"
    usage
    exit 1
fi

if [[ $rename == "True" && -z $list ]]
  then
    echo "Error: Association file (-a) is required if -r is used"
    usage
    exit 1
fi

# Optional
if [[ -z "$mapping" ]]
  then
    mapping="None"
fi

if [[ -z "$qualityscore" ]]
  then
    qualityscore=15
fi

if [[ -z "$minlength" ]]
  then
    minlength=300
fi

if [[ -z "$confidence" ]]
  then
    confidence=0.1
fi

if [[ -z "$rename" ]]
  then
    rename="False"
  else
    rename="True"
fi

if [[ -z "$unzip" ]]
  then
    unzip="False"
  else
    unzip="True"
fi

if [[ -z "$memory_mapping" ]]
  then
    memory_mapping="False"
fi

if [[ -z "$threads" ]]
  then
    threads=2
fi

# Create output directory if needed
mkdir -p "$output_dir"

# Move to working directory
cd $output_dir

# Capture MetNano code directory
DIR=$(dirname $(realpath $0))

# Lauch MetNano pipeline
python3 $DIR/scripts/run_container_MetNano.py \
  -f $FASTQ_dir \
  -r $rename \
  -a $list \
  -l $minlength \
  -q $qualityscore \
  -c $confidence \
  -d $database \
  -m $mapping \
  -u $unzip \
  -t $threads \
  -n $memory_mapping \
  -o $output_dir
